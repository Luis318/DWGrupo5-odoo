      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{47344A8D-BE5E-41C1-9992-1A7DE100C005}"
          SQLTask:SqlStatementSource="&#xA;DECLARE @inicioHoy    datetime2 = DATEADD(DAY, DATEDIFF(DAY, 0, SYSDATETIME()), 0);&#xA;DECLARE @inicioManana datetime2 = DATEADD(DAY, 1, @inicioHoy);&#xA;&#xA;DELETE FROM dw.FT_Inventario&#xA;WHERE CreatedAt &gt;= @inicioHoy&#xA;  AND CreatedAt &lt;  @inicioManana;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
