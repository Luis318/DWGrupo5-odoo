            <component
              refId="Package\FactInventariosOdoo\Origen de ADO NET"
              componentClassID="Microsoft.ManagedComponentHost"
              contactInfo="Consume datos de SQL Server, OLE DB, ODBC u Oracle mediante el correspondiente proveedor de datos de .NET Framework. Se usa una instrucción Transact-SQL para definir el conjunto de resultados. Por ejemplo, se extraen datos de SQL Server con el proveedor de datos de .NET Framework para SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;4"
              description="Consume datos de SQL Server, OLE DB, ODBC u Oracle mediante el correspondiente proveedor de datos de .NET Framework. Se usa una instrucción Transact-SQL para definir el conjunto de resultados. Por ejemplo, se extraen datos de SQL Server con el proveedor de datos de .NET Framework para SQL Server."
              name="Origen de ADO NET"
              usesDispositions="true"
              version="4">
              <properties>
                <property
                  dataType="System.String"
                  description="Especifica la instrucción SQL utilizada por el componente para extraer datos."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">/* ============================================================  

SNAPSHOT DIARIO DE INVENTARIOS (DW)  

INVENTARIO HISTÓRICO + COSTOS RESTAURADOS  

============================================================ */  

 

WITH  

 

uom AS ( 

SELECT id, 

COALESCE(name-&gt;&gt;'es_MX', name-&gt;&gt;'es_ES', name-&gt;&gt;'es_CO', name-&gt;&gt;'en_US', name-&gt;&gt;'0') AS uom_name 

FROM public.uom_uom 

), 

 

pt_names AS ( 

SELECT id, 

COALESCE(name-&gt;&gt;'es_MX', name-&gt;&gt;'es_ES', name-&gt;&gt;'es_CO', name-&gt;&gt;'en_US', name-&gt;&gt;'0') AS producto_nombre 

FROM public.product_template 

), 

 

picking_type AS ( 

SELECT id, 

COALESCE(name-&gt;&gt;'es_MX', name-&gt;&gt;'es_ES', name-&gt;&gt;'es_CO', name-&gt;&gt;'en_US', name-&gt;&gt;'0') AS picking_type_name, 

code AS picking_type_code 

FROM public.stock_picking_type 

), 

 

loc AS ( 

SELECT id, complete_name, usage 

FROM public.stock_location 

), 

 

loc_wh AS ( 

SELECT loc.id AS location_id, w.id AS warehouse_id 

FROM stock_location loc 

JOIN stock_warehouse w  

ON loc.parent_path LIKE (SELECT parent_path FROM stock_location WHERE id = w.view_location_id) || '%' 

), 

 

/* Costeo contable */  

val_layer AS ( 

SELECT 

svl.product_id, 

svl.stock_move_id::int AS move_id, 

svl.create_date AS fecha_costo, 

CASE WHEN svl.quantity IS DISTINCT FROM 0 

THEN ABS(REPLACE(svl.value::text, ',', '.')::numeric / svl.quantity) 

ELSE 0 END AS costo_unitario, 

REPLACE(svl.value::text, ',', '.')::numeric AS valor_total 

FROM public.stock_valuation_layer svl 

), 

 

/* Precios de venta/compra */  

move_price AS ( 

SELECT 

sm.id AS move_id, 

sol.price_unit AS price_unit_sale, 

pol.price_unit AS price_unit_purchase 

FROM public.stock_move sm 

LEFT JOIN public.sale_order_line sol ON sol.id = sm.sale_line_id 

LEFT JOIN public.purchase_order_line pol ON pol.id = sm.purchase_line_id 

), 

 

/* Movimientos */  

base_mov AS ( 

SELECT DISTINCT 

sml.id AS id_evento, 

sml.date AS fecha, 

COALESCE(sml.product_id, sm.product_id) AS id_producto, 

COALESCE(pp.default_code,'SIN_CODIGO') AS codigo_producto, 

ptn.producto_nombre, 

pt.categ_id AS id_categoria, 

COALESCE(pc.name,'Sin categoría') AS nombre_categoria, 

sml.location_id AS id_ubic_origen, 

l_from.usage AS usage_origen, 

sml.location_dest_id AS id_ubic_destino, 

l_to.usage AS usage_destino, 

COALESCE(sml.quantity_product_uom, sml.quantity, sm.product_uom_qty, 0) AS cantidad, 

u.uom_name AS unidad_medida, 

sm.state AS estado_move, 

sm.id AS id_move, 

sp.id AS id_picking, 

COALESCE(sp.name,'') AS codigo_picking, 

sm.company_id AS id_compania, 

ptp.picking_type_code 

FROM public.stock_move_line sml 

JOIN public.stock_move sm ON sm.id = sml.move_id 

LEFT JOIN public.stock_picking sp ON sp.id = sm.picking_id 

LEFT JOIN picking_type ptp ON ptp.id = sm.picking_type_id 

LEFT JOIN public.product_product pp ON pp.id = COALESCE(sml.product_id, sm.product_id) 

LEFT JOIN public.product_template pt ON pt.id = pp.product_tmpl_id 

LEFT JOIN pt_names ptn ON ptn.id = pt.id 

LEFT JOIN public.product_category pc ON pc.id = pt.categ_id 

LEFT JOIN uom u ON u.id = sml.product_uom_id 

LEFT JOIN loc l_from ON l_from.id = sml.location_id 

LEFT JOIN loc l_to ON l_to.id = sml.location_dest_id 

WHERE sm.state = 'done' 

), 

 

/* Clasificación */  

f AS ( 

SELECT 

bm.*, 

CASE 

WHEN bm.usage_destino = 'internal' THEN bm.id_ubic_destino 

WHEN bm.usage_origen = 'internal' THEN bm.id_ubic_origen 

ELSE bm.id_ubic_destino 

END AS id_ubic_interna, 

 

(bm.usage_destino = 'internal' AND bm.usage_origen &lt;&gt; 'internal') AS es_entrada, 

(bm.usage_origen = 'internal' AND bm.usage_destino &lt;&gt; 'internal') AS es_salida, 

bm.cantidad AS cantidad_neta 

FROM base_mov bm 

), 

 

/* Movimientos + Costos *por día/producto/almacén* */  

mov_diario AS ( 

SELECT 

CAST(to_char(f.fecha,'YYYYMMDD') AS int) AS FechaKey, 

f.id_producto, 

lw.warehouse_id AS id_almacen, 

 

SUM(CASE WHEN f.es_entrada THEN ABS(f.cantidad_neta) ELSE 0 END) AS entrada_dia, 

SUM(CASE WHEN f.es_salida THEN ABS(f.cantidad_neta) ELSE 0 END) AS salida_dia, 

 

SUM( 

CASE  

WHEN f.es_entrada AND f.usage_origen &lt;&gt; 'internal' 

THEN COALESCE(mp.price_unit_purchase, v.costo_unitario, 0) * ABS(f.cantidad_neta) 

WHEN f.es_entrada 

THEN COALESCE(v.costo_unitario, 0) * ABS(f.cantidad_neta) 

ELSE 0 

END 

) AS costo_entrada_dia, 

 

SUM( 

CASE  

WHEN f.es_salida AND f.usage_destino = 'customer' 

THEN COALESCE(mp.price_unit_sale, v.costo_unitario, 0) * ABS(f.cantidad_neta) 

WHEN f.es_salida 

THEN COALESCE(v.costo_unitario, 0) * ABS(f.cantidad_neta) 

ELSE 0 

END 

) AS costo_salida_dia 

 

FROM f 

LEFT JOIN loc_wh lw ON lw.location_id = f.id_ubic_interna 

LEFT JOIN val_layer v ON v.move_id = f.id_move 

LEFT JOIN move_price mp ON mp.move_id = f.id_move 

GROUP BY 1,2,3 

), 

 

/* Inventario acumulado histórico */  

inventario_hist AS ( 

SELECT 

*, 

SUM(entrada_dia - salida_dia) 

OVER( 

PARTITION BY id_producto, id_almacen 

ORDER BY FechaKey 

ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW 

) AS inventario_fisico_hist 

FROM mov_diario 

) 

 

SELECT 

FechaKey, 

id_producto AS Id_Producto, 

id_almacen AS Id_Almacen, 

 

entrada_dia AS Entrada_Producto, 

salida_dia AS Salida_Producto, 

 

costo_entrada_dia AS Costo_Producto_Entrante, 

costo_salida_dia AS Costo_Producto_Saliente, 

 

inventario_fisico_hist AS Inventario_Fisico, 

inventario_fisico_hist AS Inventario_Logico, 

 

0 AS Diferencia_Inventarios, 

 

CASE 

WHEN inventario_fisico_hist &lt;= 0 THEN 'Agotado' 

WHEN inventario_fisico_hist &lt;= 50 THEN 'Por agotarse' 

ELSE 'Disponible' 

END AS Estado_Stock, 

 

now() AS CreatedAt 

 

FROM inventario_hist 

ORDER BY FechaKey, Id_Producto, Id_Almacen;</property>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">30</property>
                <property
                  dataType="System.Boolean"
                  description="Indica si se debe permitir que columnas externas que no sean de cadenas se conviertan implícitamente en cadenas en las columnas de salida."
                  name="AllowImplicitStringConversion">true</property>
                <property
                  dataType="System.String"
                  description="Nombre de la tabla de la base de datos de origen."
                  expressionType="Notify"
                  name="TableOrViewName"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor"></property>
                <property
                  dataType="System.Int32"
                  description="Especificar el modo de recuperar información de columnas externas"
                  name="AccessMode"
                  typeConverter="Microsoft.SqlServer.Dts.Pipeline.DataReaderSourceAdapter+EnumToStringConverter">2</property>
                <property
                  dataType="System.String"
                  name="UserComponentTypeName">Microsoft.DataReaderSourceAdapter</property>
              </properties>
              <connections>
                <connection
                  refId="Package\FactInventariosOdoo\Origen de ADO NET.Connections[IDbConnection]"
                  connectionManagerID="{60BA7266-6AA7-4EE0-B3F5-DAA6F39B86F4}:external"
                  connectionManagerRefId="Project.ConnectionManagers[CM_PG]"
                  description="Administrador de conexiones administrado"
                  name="IDbConnection" />
              </connections>
              <outputs>
                <output
                  refId="Package\FactInventariosOdoo\Origen de ADO NET.Outputs[Salida de origen de ADO NET]"
                  name="Salida de origen de ADO NET">
                  <outputColumns>
                    <outputColumn
                      refId="Package\FactInventariosOdoo\Origen de ADO NET.Outputs[Salida de origen de ADO NET].Columns[fechakey]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversión"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\FactInventariosOdoo\Origen de ADO NET.Outputs[Salida de origen de ADO NET].ExternalColumns[fechakey]"
                      lineageId="Package\FactInventariosOdoo\Origen de ADO NET.Outputs[Salida de origen de ADO NET].Columns[fechakey]"
                      name="fechakey"
                      truncationRowDisposition="FailComponent" />
