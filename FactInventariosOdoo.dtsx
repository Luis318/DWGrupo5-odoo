            <component
              refId="Package\FactInventariosOdoo\Origen de ADO NET"
              componentClassID="Microsoft.ManagedComponentHost"
              contactInfo="Consume datos de SQL Server, OLE DB, ODBC u Oracle mediante el correspondiente proveedor de datos de .NET Framework. Se usa una instrucción Transact-SQL para definir el conjunto de resultados. Por ejemplo, se extraen datos de SQL Server con el proveedor de datos de .NET Framework para SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;4"
              description="Consume datos de SQL Server, OLE DB, ODBC u Oracle mediante el correspondiente proveedor de datos de .NET Framework. Se usa una instrucción Transact-SQL para definir el conjunto de resultados. Por ejemplo, se extraen datos de SQL Server con el proveedor de datos de .NET Framework para SQL Server."
              name="Origen de ADO NET"
              usesDispositions="true"
              version="4">
              <properties>
                <property
                  dataType="System.String"
                  description="Especifica la instrucción SQL utilizada por el componente para extraer datos."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">/* ============================================================ 

SNAPSHOT DIARIO DE INVENTARIOS (DW) 

============================================================ */ 

 

WITH 

uom AS ( 

SELECT id, 

COALESCE(name-&gt;&gt;'es_MX', name-&gt;&gt;'es_ES', name-&gt;&gt;'es_CO', name-&gt;&gt;'en_US', name-&gt;&gt;'0')::text AS uom_name 

FROM public.uom_uom 

), 

pt_names AS ( 

SELECT id, 

COALESCE(name-&gt;&gt;'es_MX', name-&gt;&gt;'es_ES', name-&gt;&gt;'es_CO', name-&gt;&gt;'en_US', name-&gt;&gt;'0')::text AS producto_nombre 

FROM public.product_template 

), 

picking_type AS ( 

SELECT id, 

COALESCE(name-&gt;&gt;'es_MX', name-&gt;&gt;'es_ES', name-&gt;&gt;'es_CO', name-&gt;&gt;'en_US', name-&gt;&gt;'0')::text AS picking_type_name, 

code::text AS picking_type_code 

FROM public.stock_picking_type 

), 

loc AS ( 

SELECT l.id, 

l.complete_name, 

l.usage::text AS usage 

FROM public.stock_location l 

), 

loc_wh AS ( 

SELECT loc.id AS location_id, w.id AS warehouse_id 

FROM stock_location loc 

JOIN stock_warehouse w 

ON loc.parent_path LIKE (SELECT parent_path FROM stock_location WHERE id = w.view_location_id) || '%' 

), 

quant AS ( 

SELECT q.product_id, 

lw.warehouse_id, 

COALESCE(SUM(q.quantity),0)::numeric(18,6) AS qty_on_hand, 

COALESCE(SUM(q.reserved_quantity),0)::numeric(18,6) AS qty_reserved 

FROM public.stock_quant q 

JOIN loc_wh lw ON lw.location_id = q.location_id 

GROUP BY q.product_id, lw.warehouse_id 

), 

 

/* Costeo contable por movimiento (fallback) */ 

val_layer AS ( 

SELECT 

svl.product_id, 

svl.stock_move_id::int AS move_id, 

svl.create_date::timestamp AS fecha_costo, 

CASE WHEN svl.quantity IS DISTINCT FROM 0 

THEN ABS(REPLACE(svl.value::text, ',', '.')::numeric / svl.quantity) 

ELSE 0 END::numeric(18,6) AS costo_unitario, 

REPLACE(svl.value::text, ',', '.')::numeric(18,6) AS valor_total 

FROM public.stock_valuation_layer svl 

), 

 

/* Precios de venta/compra por movimiento */ 

move_price AS ( 

SELECT 

sm.id::int AS move_id, 

sol.price_unit::numeric(18,6) AS price_unit_sale, 

pol.price_unit::numeric(18,6) AS price_unit_purchase 

FROM public.stock_move sm 

LEFT JOIN public.sale_order_line sol ON sol.id = sm.sale_line_id 

LEFT JOIN public.purchase_order_line pol ON pol.id = sm.purchase_line_id 

), 

 

/* Movimientos (state=done), SIN dividir entre 100 */ 

base_mov AS ( 

SELECT DISTINCT 

sml.id::int AS id_evento, 

sml."date"::timestamp AS fecha, 

COALESCE(sml.product_id, sm.product_id)::int AS id_producto, 

COALESCE(pp.default_code,'SIN_CODIGO')::text AS codigo_producto, 

ptn.producto_nombre::text AS nombre_producto, 

pt.categ_id::int AS id_categoria, 

COALESCE(pc.name,'Sin categoría')::text AS nombre_categoria, 

 

sml.location_id::int AS id_ubic_origen, 

l_from.usage AS usage_origen, 

sml.location_dest_id::int AS id_ubic_destino, 

l_to.usage AS usage_destino, 

 

/* &lt;- AQUÍ: cantidades sin /100 */ 

COALESCE( 

sml.quantity_product_uom, -- presente en tu base 

sml.quantity, -- alternativa 

sm.product_uom_qty, -- fallback 

0 

)::numeric(18,6) AS cantidad, 

 

u.uom_name::text AS unidad_medida, 

sm.state::text AS estado_move, 

sm.id::int AS id_move, 

sp.id::int AS id_picking, 

COALESCE(sp.name,'')::text AS codigo_picking, 

sm.company_id::int AS id_compania, 

ptp.picking_type_code::text AS picking_type_codigo 

FROM public.stock_move_line sml 

JOIN public.stock_move sm ON sm.id = sml.move_id 

LEFT JOIN public.stock_picking sp ON sp.id = sm.picking_id 

LEFT JOIN picking_type ptp ON ptp.id = sm.picking_type_id 

LEFT JOIN public.product_product pp ON pp.id = COALESCE(sml.product_id, sm.product_id) 

LEFT JOIN public.product_template pt ON pt.id = pp.product_tmpl_id 

LEFT JOIN pt_names ptn ON ptn.id = pt.id 

LEFT JOIN public.product_category pc ON pc.id = pt.categ_id 

LEFT JOIN uom u ON u.id = sml.product_uom_id 

LEFT JOIN loc l_from ON l_from.id = sml.location_id 

LEFT JOIN loc l_to ON l_to.id = sml.location_dest_id 

WHERE sm.state = 'done' 

), 

 

/* Clasificación por usage */ 

f AS ( 

SELECT 

bm.*, 

CASE 

WHEN bm.usage_destino = 'internal' THEN bm.id_ubic_destino 

WHEN bm.usage_origen = 'internal' THEN bm.id_ubic_origen 

ELSE bm.id_ubic_destino 

END::int AS id_ubic_interna, 

 

(bm.usage_destino = 'internal' AND bm.usage_origen &lt;&gt; 'internal') AS es_entrada, 

(bm.usage_origen = 'internal' AND bm.usage_destino &lt;&gt; 'internal') AS es_salida, 

(bm.usage_origen = 'internal' AND bm.usage_destino = 'internal') AS es_transfer, 

 

bm.cantidad::numeric(18,6) AS cantidad_neta 

FROM base_mov bm 

) 

 

SELECT 

CAST(to_char(f.fecha,'YYYYMMDD') AS int) AS FechaKey, 

f.id_producto AS Id_Producto, 

COALESCE(lw.warehouse_id,0) AS Id_Almacen, 

 

/* Entradas y salidas (ahora deben ser 1.000000 si moviste 1) */ 

SUM(CASE WHEN f.es_entrada THEN ABS(f.cantidad_neta) ELSE 0 END)::numeric(18,6) AS Entrada_Producto, 

SUM(CASE WHEN f.es_salida THEN ABS(f.cantidad_neta) ELSE 0 END)::numeric(18,6) AS Salida_Producto, 

 

/* Costos: 

- Entrada: si viene de supplier, usar precio de compra; si no, SVL. 

- Salida : si va a customer, usar precio de venta; si no, SVL. 

*/ 

SUM( 

CASE 

WHEN f.es_entrada AND f.usage_origen &lt;&gt; 'internal' /* supplier/inventory/production/transit */ 

THEN COALESCE(mp.price_unit_purchase, v.costo_unitario, 0) * ABS(f.cantidad_neta) 

WHEN f.es_entrada 

THEN COALESCE(v.costo_unitario, 0) * ABS(f.cantidad_neta) 

ELSE 0 

END 

)::numeric(18,6) AS Costo_Producto_Entrante, 

 

SUM( 

CASE 

WHEN f.es_salida AND f.usage_destino = 'customer' 

THEN COALESCE(mp.price_unit_sale, v.costo_unitario, 0) * ABS(f.cantidad_neta) 

WHEN f.es_salida 

THEN COALESCE(v.costo_unitario, 0) * ABS(f.cantidad_neta) 

ELSE 0 

END 

)::numeric(18,6) AS Costo_Producto_Saliente, 

 

COALESCE(MAX(q.qty_on_hand),0)::numeric(18,6) AS Inventario_Fisico, 

COALESCE(MAX(q.qty_on_hand - q.qty_reserved),0)::numeric(18,6) AS Inventario_Logico, 

( COALESCE(MAX(q.qty_on_hand),0) - COALESCE(MAX(q.qty_on_hand - q.qty_reserved),0) )::numeric(18,6) AS Diferencia_Inventarios, 

 

CASE 

WHEN COALESCE(MAX(q.qty_on_hand - q.qty_reserved),0) &lt;= 0 THEN 'Agotado' 

WHEN COALESCE(MAX(q.qty_on_hand - q.qty_reserved),0) &lt;= 5 THEN 'Por agotarse' 

ELSE 'Disponible' 

END::text AS Estado_Stock, 

 

now()::timestamp AS CreatedAt 

 

FROM f 

LEFT JOIN loc_wh lw 

ON lw.location_id = f.id_ubic_interna 

LEFT JOIN quant q 

ON q.product_id = f.id_producto AND q.warehouse_id = lw.warehouse_id 

LEFT JOIN val_layer v 

ON v.move_id = f.id_move 

LEFT JOIN move_price mp 

ON mp.move_id = f.id_move 

WHERE f.estado_move = 'done' 

GROUP BY 

CAST(to_char(f.fecha,'YYYYMMDD') AS int), 

f.id_producto, 

lw.warehouse_id 

ORDER BY FechaKey, Id_Producto, Id_Almacen;</property>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">30</property>
                <property
                  dataType="System.Boolean"
                  description="Indica si se debe permitir que columnas externas que no sean de cadenas se conviertan implícitamente en cadenas en las columnas de salida."
                  name="AllowImplicitStringConversion">true</property>
                <property
                  dataType="System.String"
                  description="Nombre de la tabla de la base de datos de origen."
                  expressionType="Notify"
                  name="TableOrViewName"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor"></property>
                <property
                  dataType="System.Int32"
                  description="Especificar el modo de recuperar información de columnas externas"
                  name="AccessMode"
                  typeConverter="Microsoft.SqlServer.Dts.Pipeline.DataReaderSourceAdapter+EnumToStringConverter">2</property>
